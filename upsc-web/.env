# Default Supabase connection for this project, committed on purpose.
#
# Both values below are PUBLIC by design: Next.js inlines any NEXT_PUBLIC_*
# variable into the browser bundle, so every visitor already receives them.
# What protects the data is Row Level Security, not the secrecy of this key.
#
# NEVER add the service_role / secret key here — that one bypasses RLS.
#
# To point a checkout at a different project, create .env.local (git-ignored);
# it takes precedence over this file.

NEXT_PUBLIC_SUPABASE_URL=https://kiaaeowupxmmizcmtbib.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_bz0EDi-rNAsk3VNfOZDCNw_N3_I_mKf
