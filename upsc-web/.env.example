# Copy to .env.local and fill in from your Supabase project
# Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Canonical origin for canonical tags, Open Graph, sitemap, robots.
# Vercel infers this automatically; set it when using a custom domain.
# Must be present at BUILD time, not just runtime.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
